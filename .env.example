# HTTP server (API + production static build)
PORT=4000
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API directly.
# Same-origin requests are always allowed automatically. The default Vite dev
# server runs on port 3000 and proxies /api, so no extra origin is required there.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true only when running behind a trusted reverse proxy (nginx, CDN...).
TRUST_PROXY=false
